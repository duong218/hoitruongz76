# Cổng chạy server
PORT=5000

# MongoDB cài trên máy. Dùng 127.0.0.1 thay vì localhost để tránh lỗi trên Windows.
MONGO_URI=mongodb://127.0.0.1:27017/hoitruongz76

# Địa chỉ client (Vite) được phép gọi API
CLIENT_ORIGIN=http://localhost:3000

# Bắt buộc, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Mật khẩu tài khoản mẫu khi chạy seed (tối thiểu 8 ký tự)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
