# Cổng chạy server
PORT=5000

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=hoitruongz76
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Hoặc dùng chuỗi kết nối trực tiếp (nếu có sẽ ưu tiên dùng):
# DB_CONNECTION_STRING=Server=localhost,1433;Database=hoitruongz76;User Id=sa;Password=...;TrustServerCertificate=true;

# Địa chỉ client (Vite) được phép gọi API
CLIENT_ORIGIN=http://localhost:3000

# Bắt buộc, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Mật khẩu tài khoản mẫu khi chạy seed (tối thiểu 8 ký tự)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
