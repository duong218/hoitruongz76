# Sao chép thành file .env (cùng thư mục với docker-compose.yml) rồi điền.

# Địa chỉ người dùng gõ vào trình duyệt, KHÔNG có dấu / ở cuối.
# Mạng nội bộ:  http://192.168.1.10   (IP của máy chạy Docker)
# Khi có tên miền: https://hoitruong.z76.vn
PUBLIC_URL=http://192.168.1.10

# Để trống khi chạy mạng nội bộ. Khi có tên miền: hoitruong.z76.vn
SITE_ADDRESS=

# Chuỗi dài, ngẫu nhiên, không chia sẻ.
JWT_SECRET=

# Mật khẩu tài khoản Quản trị / Quản lý khi nạp dữ liệu mẫu (tối thiểu 8 ký tự)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
